<mxCell id="zendesk" value='&lt;b&gt;&lt;font style="font-size:14px" color="#1f2328"&gt;&lt;font color="#1f6feb"&gt;①&lt;/font&gt; Zendesk API&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Menlo"&gt;/api/v2/help_center/&lt;/font&gt;&lt;br&gt;&lt;font face="Menlo"&gt;en-us/articles.json&lt;/font&gt;&lt;br&gt;public, no key needed' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#424a53;fillColor=#fff6ec;strokeColor=#e8a868;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="scraper" value='&lt;b&gt;&lt;font style="font-size:14px" color="#1f2328"&gt;&lt;font color="#1f6feb"&gt;②&lt;/font&gt; kb/scraper.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;100 per page, next_page&lt;br&gt;skips drafts&lt;br&gt;retries 429 and 5xx' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#424a53;fillColor=#ffffff;strokeColor=#c4ccd5;" vertex="1" parent="1"><mxGeometry x="270" y="238" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="convert" value='&lt;b&gt;&lt;font style="font-size:14px" color="#1f2328"&gt;&lt;font color="#1f6feb"&gt;③&lt;/font&gt; kb/convert.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTML → clean Markdown&lt;br&gt;drops nav, widgets, scripts&lt;br&gt;videos → links, TIP → quote' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#424a53;fillColor=#ffffff;strokeColor=#c4ccd5;" vertex="1" parent="1"><mxGeometry x="500" y="238" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="document" value='&lt;b&gt;&lt;font style="font-size:14px" color="#1f2328"&gt;&lt;font color="#1f6feb"&gt;④&lt;/font&gt; kb/document.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;front matter, # Title,&lt;br&gt;Article URL:, slug&lt;br&gt;content hash (sha256)' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#424a53;fillColor=#ffffff;strokeColor=#c4ccd5;" vertex="1" parent="1"><mxGeometry x="730" y="238" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="articles" value='&lt;b&gt;&lt;font style="font-size:14px" color="#1f2328"&gt;articles/*.md&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Markdown snapshot,&lt;br&gt;one file per article,&lt;br&gt;kept in the repo' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#424a53;fillColor=#ffffff;strokeColor=#c4ccd5;dashed=1;dashPattern=5 4;strokeColor=#8c959f;" vertex="1" parent="1"><mxGeometry x="960" y="238" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="chunker" value='&lt;b&gt;&lt;font style="font-size:14px" color="#1f2328"&gt;&lt;font color="#1f6feb"&gt;⑤&lt;/font&gt; kb/chunker.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;splits at ## to #### headings&lt;br&gt;at most 2,400 chars per chunk&lt;br&gt;code blocks never split&lt;br&gt;title + Article URL in every chunk' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#424a53;fillColor=#ffffff;strokeColor=#c4ccd5;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="sync" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1f2328&quot;&gt;&lt;font color=&quot;#1f6feb&quot;&gt;⑥&lt;/font&gt; kb/sync.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;compares each article's hash with the store&lt;br&gt;→ added · updated · skipped · removed&lt;br&gt;uploads new chunks first (8 in parallel),&lt;br&gt;then deletes the old ones" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#424a53;fillColor=#ffffff;strokeColor=#c4ccd5;" vertex="1" parent="1"><mxGeometry x="360" y="418" width="360" height="120" as="geometry"/></mxCell>
<mxCell id="store" value='&lt;b&gt;&lt;font style="font-size:14px" color="#1f2328"&gt;&lt;font color="#1f6feb"&gt;⑦&lt;/font&gt; OpenAI vector store&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Menlo"&gt;optibot-help-center&lt;/font&gt;&lt;br&gt;1 file = 1 chunk (static, 4,096 tokens)&lt;br&gt;attributes: article_id, content_hash,&lt;br&gt;part / parts, url, title' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#424a53;fillColor=#eef5ff;strokeColor=#6f9fd8;" vertex="1" parent="1"><mxGeometry x="820" y="418" width="340" height="120" as="geometry"/></mxCell>
<mxCell id="question" value='&lt;b&gt;&lt;font style="font-size:14px" color="#1f2328"&gt;Question&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;"How do I add a&lt;br&gt;YouTube video?"' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#424a53;fillColor=#ffffff;strokeColor=#c4ccd5;" vertex="1" parent="1"><mxGeometry x="40" y="638" width="260" height="104" as="geometry"/></mxCell>
<mxCell id="responses" value='&lt;b&gt;&lt;font style="font-size:14px" color="#1f2328"&gt;Responses API + file_search tool&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;model gpt-5-mini, instructions = assistant/system_prompt.md&lt;br&gt;searches the vector store and answers only from the chunks it finds&lt;br&gt;(the Assistants API was retired on 26 Aug 2026)' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#424a53;fillColor=#eef5ff;strokeColor=#6f9fd8;" vertex="1" parent="1"><mxGeometry x="360" y="638" width="640" height="104" as="geometry"/></mxCell>
