<mxCell id="run" value='&lt;b&gt;&lt;font style="font-size:14px" color="#1f2328"&gt;docker run … main.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;API_KEY from the&lt;br&gt;OPENAI_API_KEY secret' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#424a53;fillColor=#ffffff;strokeColor=#c4ccd5;" vertex="1" parent="1"><mxGeometry x="626" y="88" width="240" height="72" as="geometry"/></mxCell>
